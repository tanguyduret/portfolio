{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "tanguyduret.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?:index[.]html|(?:en|es)(?:/index[.]html|/)?)?)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/es",
      "destination": "/es/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/conseil/guide",
      "destination": "/conseil/guide/index.html"
    },
    {
      "source": "/conseil/guide/:slug(ce-qu-il-ne-faut-pas-faire|demander-un-avis-correctement|pourquoi-les-avis-comptent|repondre-aux-avis-google)",
      "destination": "/conseil/guide/:slug.html"
    },
    {
      "source": "/conseil/mentions-legales",
      "destination": "/conseil/mentions-legales.html"
    },
    {
      "source": "/conseil/politique-confidentialite",
      "destination": "/conseil/politique-confidentialite.html"
    },
    {
      "source": "/conseil",
      "destination": "/conseil/index.html"
    },
    {
      "source": "/conseil/",
      "destination": "/conseil/index.html"
    }
  ]
}
